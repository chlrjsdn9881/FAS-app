{
  "expo": {
    "name": "EmergencyApp",
    "slug": "EmergencyApp",
    "version": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c180f013-a05e-4cc5-91cf-8eba7c5f2ce9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "화재 경보 소리를 감지하기 위해 마이크를 사용합니다."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "대피 경로 안내를 위해 주변 블루투스 비콘을 스캔합니다."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "대피 경로 안내를 위해 주변 블루투스 비콘을 스캔합니다.",
        "NSBluetoothPeripheralUsageDescription": "대피 경로 안내를 위해 주변 블루투스 비콘을 스캔합니다.",
        "NSMicrophoneUsageDescription": "화재 경보 소리를 감지하기 위해 마이크를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.gunwoochoi.EmergencyApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.gunwoochoi.EmergencyApp",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c180f013-a05e-4cc5-91cf-8eba7c5f2ce9"
      }
    },
    "owner": "gunwoochoi"
  }
}
